# AntonioWM 0.4.14: ejemplo de configuracion de usuario.
# Copiar como ~/.config/antoniowm/config y adaptar las rutas de iconos.

terminal=xfce4-terminal
screenshot.command=maim | xclip -selection clipboard -t image/png -i
focus_follows_mouse=false

# Se ejecuta una vez al comenzar la sesion, no al usar Super+Mayus+R.
autostart.count=2
autostart.1.command=volumeicon
autostart.2.command=nm-applet

# Vacio: salida limpia de AntonioWM. En GDM vuelve al gestor de sesiones.
system.logout.command=
# Vacio: usa gdmflexiserver si esta disponible; si no, desactiva la opcion.
system.switch_user.command=
system.reboot.command=systemctl reboot
system.poweroff.command=systemctl poweroff

taskbar.enabled=true
taskbar.height=30
taskbar.gap=4
taskbar.padding=4
taskbar.preview=true
taskbar.preview_delay=350
taskbar.preview_width=320
taskbar.preview_height=200
taskbar.launcher_count=4

launcher.1.label=Chrome
launcher.1.command=google-chrome
launcher.1.icon=icons/chrome.png

launcher.2.label=Terminal
launcher.2.command=xfce4-terminal
launcher.2.icon=icons/terminal.png

launcher.3.label=Archivos
launcher.3.command=pcmanfm
launcher.3.icon=icons/files.png

launcher.4.label=GIMP
launcher.4.command=gimp
launcher.4.icon=icons/gimp.png

# Entre 1 y 16; se aplica al iniciar o reiniciar internamente.
desktop.count=4
desktop.1=Trabajo
desktop.2=Web
desktop.3=Multimedia
desktop.4=Otros
